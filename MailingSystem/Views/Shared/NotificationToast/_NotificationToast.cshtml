<div class="mail-notification-container">
    <div id="newMessageToast" class="toast mail-notification" role="status" aria-live="polite" aria-atomic="true">

        <div class="mail-notification-content">
            <div class="mail-notification-icon">
                <i class="bi bi-envelope-fill" aria-hidden="true"></i>
            </div>

            <div class="mail-notification-text">
                <strong>@Localizer["NewMessage"]</strong>
                <span>@Localizer["NewMessageNotification"]</span>
            </div>

            <button type="button" class="mail-notification-close" data-bs-dismiss="toast"
                    aria-label="@Localizer["Close"]">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>