               aria-hidden="true"></i>
            @Localizer["BackToInbox"]
        </a>
        @* <div class="compose-page-title">
            <span class="compose-page-icon" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
            <div>
                <h1>@Localizer["NewMessage"]</h1>
            </div>
        </div> *@
    </div>

    <div class="compose-surface">
        @await Html.PartialAsync("~/Views/Shared/ComposeEditor/_ComposeForm.cshtml")
    </div>
</div>
