@model ViewModel.ComposeViewModel
@{
    ViewData["Title"] = "Compose";
}

<div class="compose-page">
    <div class="compose-page-heading">
        <a asp-controller="Home" asp-action="Inbox" class="compose-back-link">
            <i class="bi @(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "bi-arrow-right" : "bi-arrow-left")"
               aria-hidden="true"></i>
            @Localizer["BackToInbox"]
        </a>
    </div>

    <div class="compose-surface">
        @await Html.PartialAsync("~/Views/Shared/ComposeEditor/_ComposeForm.cshtml", Model)
    </div>
</div>
