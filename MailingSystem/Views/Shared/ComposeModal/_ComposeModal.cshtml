<div id="composeWindow" class="compose-window" role="dialog" aria-modal="false" aria-labelledby="composeTitle" hidden>

    <div class="compose-header">
        <span id="composeTitle">@Localizer["NewMessage"]</span>

        <div class="compose-header-actions">
            <button type="button" id="minimizeCompose" aria-label="@Localizer["Minimize"]">
                <i class="bi bi-dash"></i>
            </button>
            <button type="button" class="d-none" id="maximizeCompose" aria-label="@Localizer["Maximize"]">
                <i class="bi bi-chevron-up"></i>
            </button>
            <button type="button" id="closeCompose" aria-label="@Localizer["Close"]">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("~/Views/Shared/ComposeEditor/_ComposeForm.cshtml",
        viewData: new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
        {
            ["ComposeIdPrefix"] = "compose"
        })
</div>
