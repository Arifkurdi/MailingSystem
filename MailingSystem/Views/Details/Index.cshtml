@model MailingSystem.ViewModel.MailViewModel

@{
    ViewData["Title"] = "Mail Details";
    ViewData["ActiveFolder"] = Model.FolderName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var backIcon = isRtl ? "bi-arrow-right" : "bi-arrow-left";
    var refreshLabel = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "إعادة توجيه" : "Forward";
}

<div class="mail-details">

    <!-- Toolbar -->
    <div class="details-toolbar">
        <a asp-controller="Home" asp-action="@Model.FolderAction" asp-route-page="@Model.FolderPage" class="back-button action-button">
            <i class="bi @backIcon" aria-hidden="true"></i>
            <span>@Localizer["BackToFolder", Localizer[Model.FolderName].Value]</span>
        </a>

        <div class="toolbar-actions">
            <a asp-controller="" asp-action="" asp-route-id="@Model.Mail.Id" asp-route-page="" class="action-button">
                <i class="bi bi-reply"></i>
                <span>@refreshLabel</span>
            </a>
        </div>
    </div>

    <!-- Message -->
    <article class="message-card">

        <header class="message-header">
            <h1 class="message-subject" dir="auto">
                @Model.Mail.Subject
            </h1>

            <div class="message-meta">
                <div class="sender-avatar">
                    @Model.Mail.From.Substring(0, 1).ToUpper()
                </div>

                <div class="sender-information">
                    <strong>@Model.Mail.From</strong>
                    <span>@Localizer["To", Model.Mail.To]</span>
                </div>

                <time class="message-date">
                    @Model.Mail.SentAt.ToString("MMM dd, yyyy HH:mm")
                </time>
            </div>
        </header>

        <div class="message-body" dir="auto">
            @Model.Mail.Body
        </div>

    </article>

</div>
